# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Local docker-compose: leave as-is, it matches docker-compose.yml's
# bundled postgres service (and PGSSLMODE=disable is set there directly,
# not needed here).
# On Render: DO NOT set this manually - render.yaml injects it
# automatically from the attached Postgres instance via `fromDatabase`.
DATABASE_URL=postgresql://botuser:botpass@localhost:5432/tradingbot

# --- Alpaca ---
# PAPER: Alpaca allows up to 3 paper accounts per login - create a SECOND
# one dedicated to this bot (Account menu -> paper account switcher ->
# create new) rather than reusing your other bot's paper account. That
# gives you genuinely isolated testing, not just tagged/shared testing.
# Generate that new paper account's key pair at
# https://app.alpaca.markets -> API Keys (with it selected).
ALPACA_PAPER_API_KEY=your_paper_key_id
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key

# LIVE: live accounts don't have the same multi-account allowance - this
# still shares your existing live account with your other bot (see the
# README's "Sharing one Alpaca account" section for how that's handled).
# Generate a separate LIVE key pair for this bot the normal way; leave
# blank until you're ready to go live.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Prefix on every client_order_id this bot submits, so its orders are
# distinguishable from your other bot's in Alpaca's own activity/history.
BOT_ORDER_TAG=aitradingbot

# Second, deliberate gate on top of rules.json's "mode" field. The bot only
# ever connects with LIVE keys and places live orders if this is explicitly
# "true" - flipping the dashboard to Live mode is NOT enough by itself.
# Requires editing this file on the host and restarting the bot container.
ALLOW_LIVE_TRADING=false

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard login ---
DASHBOARD_USERNAME=admin
# Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
DASHBOARD_PASSWORD_HASH=
# Any long random string, e.g. `openssl rand -hex 32`
DASHBOARD_SECRET_KEY=change-me-to-a-random-secret
SESSION_TTL_HOURS=12

# --- Misc ---
MARKET_TIMEZONE=America/New_York
